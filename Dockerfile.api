# syntax=docker/dockerfile:1

# Yamban API: NestJS 12 (ESM) with Drizzle ORM
# Multi stage build for smaller production image

# ------------------------------------------------------------------------------
# Stage 1: Base with pnpm
# ------------------------------------------------------------------------------
FROM node:22-alpine AS base

# Install pnpm (pinned to match packageManager in package.json)
RUN corepack enable && corepack prepare pnpm@12.8.1 --activate

WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 2: Install all dependencies and build
# ------------------------------------------------------------------------------
FROM base AS build

# Copy workspace configuration files first
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./

# Create workspace directories and copy package.json files
RUN mkdir -p apps/api apps/web packages/shared
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies (including devDependencies for build)
# --ignore-scripts: skip build scripts that require approval in pnpm 12+
RUN pnpm install --ignore-scripts

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared package first (api depends on it)
RUN pnpm --filter @yamban/shared build

# Build the API
RUN pnpm --filter @yamban/api build

# ------------------------------------------------------------------------------
# Stage 3: Production runtime (uses base for pnpm access)
# ------------------------------------------------------------------------------
FROM base AS production

# Add non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

WORKDIR /app

# Copy package files for pnpm to work
COPY --from=build /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/package.json ./
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/web/package.json ./apps/web/
COPY --from=build /app/packages/shared/package.json ./packages/shared/

# Copy node_modules (with all dependencies for migrations)
COPY --from=build --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nestjs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=nestjs:nodejs /app/packages/shared/node_modules ./packages/shared/node_modules

# Copy built code
COPY --from=build --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=nestjs:nodejs /app/packages/shared/dist ./packages/shared/dist

# Copy drizzle config and migrations for runtime migrations
COPY --from=build --chown=nestjs:nodejs /app/apps/api/drizzle.config.ts ./apps/api/
COPY --from=build --chown=nestjs:nodejs /app/apps/api/drizzle ./apps/api/drizzle

# Copy source files needed for drizzle-kit (config and seed)
COPY --from=build --chown=nestjs:nodejs /app/apps/api/src/config ./apps/api/src/config
COPY --from=build --chown=nestjs:nodejs /app/apps/api/src/db ./apps/api/src/db

# Create uploads directory
RUN mkdir -p /app/apps/api/uploads && chown nestjs:nodejs /app/apps/api/uploads

USER nestjs

WORKDIR /app/apps/api

ENV NODE_ENV=production

EXPOSE 4000

CMD ["node", "dist/main.js"]
