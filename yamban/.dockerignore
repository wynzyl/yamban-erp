# IMPORTANT: Never exclude these workspace files
!pnpm-lock.yaml
!pnpm-workspace.yaml
!package.json
!tsconfig.base.json

# Dependencies (will be installed fresh in container)
node_modules
**/node_modules

# Build outputs
dist
**/dist
.next
**/.next
.turbo
**/.turbo

# Development files
*.tsbuildinfo
coverage
**/*.spec.ts
**/*.test.ts

# Environment files (secrets)
.env
.env.*
!.env.example
!.env.production.example

# IDE and OS
.DS_Store
.idea
.vscode
*.swp
*.swo

# Git
.git
.gitignore

# Documentation (not needed in container)
*.md
!README.md
docs

# Misc
cookies.txt
nul
