# Copy to .env at the repo root. Both apps read this one file.

# --- Database ---
DATABASE_URL=postgres://yamban:yamban@localhost:5432/yamban

# --- API (NestJS) ---
API_PORT=4000
# Origin of the web app, for CORS (only needed if the browser calls the API directly).
WEB_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# true in production (HTTPS). false for http://localhost.
COOKIE_SECURE=false

# --- Seed: first owner account (no public sign-up) ---
SEED_OWNER_EMAIL=owner@yamban.local
SEED_OWNER_NAME=Shop Owner
SEED_OWNER_PASSWORD=change-me-now

# --- Web (Next.js) ---
# Where the Next.js server reaches the API. The browser never calls this directly;
# it goes through the /api rewrite in apps/web/next.config.ts.
API_INTERNAL_URL=http://localhost:4000
