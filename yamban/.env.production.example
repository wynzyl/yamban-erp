# Copy to .env.production at the repo root.
# This file is for Docker Compose production deployment.
# KEEP .env.production OUT OF VERSION CONTROL (it contains secrets).

# --- General ---
NODE_ENV=production

# --- Database ---
# Uses the Docker service name "postgres" instead of localhost
DATABASE_URL=postgres://yamban:yamban@postgres:5432/yamban

# --- API (NestJS) ---
API_PORT=4000
# The hostname clients use to reach the app (for CORS and cookies)
WEB_ORIGIN=http://yamban-erp.local
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# false for HTTP on LAN; set true only with HTTPS
COOKIE_SECURE=false

# --- Seed: first owner account ---
SEED_OWNER_EMAIL=owner@yamban.local
SEED_OWNER_NAME=Shop Owner
SEED_OWNER_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# --- Web (Next.js) ---
# Uses the Docker service name "api" instead of localhost
API_INTERNAL_URL=http://api:4000
