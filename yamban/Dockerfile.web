# syntax=docker/dockerfile:1

# Yamban Web: Next.js 16 (App Router) with standalone output
# Multi stage build for smaller production image

# ------------------------------------------------------------------------------
# Stage 1: Base with pnpm
# ------------------------------------------------------------------------------
FROM node:22-alpine AS base

# Install pnpm (pinned to match packageManager in package.json)
RUN corepack enable && corepack prepare pnpm@12.8.1 --activate

WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 2: Install all dependencies and build
# ------------------------------------------------------------------------------
FROM base AS build

# Copy workspace configuration files first
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./

# Create workspace directories and copy package.json files
RUN mkdir -p apps/api apps/web packages/shared
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies (including devDependencies for build)
# --ignore-scripts: skip build scripts that require approval in pnpm 12+
RUN pnpm install --ignore-scripts

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Build shared package first (web depends on it)
RUN pnpm --filter @yamban/shared build

# Set build time environment variables
# API_INTERNAL_URL is needed at build time for the rewrites config
ARG API_INTERNAL_URL=http://api:4000
ENV API_INTERNAL_URL=${API_INTERNAL_URL}

# Build the web app with standalone output
RUN pnpm --filter @yamban/web build

# ------------------------------------------------------------------------------
# Stage 3: Production runtime
# ------------------------------------------------------------------------------
FROM node:22-alpine AS production

# Add non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Copy the standalone build output
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs

WORKDIR /app/apps/web

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["node", "server.js"]
